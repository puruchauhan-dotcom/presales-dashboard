# Port (Railway injects PORT automatically)
PORT=8787
# Google Sheet id of "Puru - Personal Presales Tracker"
SHEET_ID=15ZC45Z1BpCuNUoTIyDL_0GRWGs0jXtJY2lKOQwkiR-A
# Full service-account key JSON on ONE line (or base64 of it). Share the sheet with the SA email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Password required to open the dashboard. Leave empty to disable the gate (local dev only).
DASHBOARD_PASSWORD=
# Optional: secret used to sign the session cookie (defaults to a hash of DASHBOARD_PASSWORD)
SESSION_SECRET=
# Optional: cache TTL in seconds (default 300)
CACHE_TTL_SECONDS=300
# --- AI chat (Google Gemini REST) ---
GEMINI_API_KEY=
# Default gemini-2.5-flash; on 404/503/429 falls back through GEMINI_FALLBACK_MODELS
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest
# --- CREATOR escalation queue ---
# Bearer token CREATOR uses for GET /api/questions and POST /api/questions/:id/answer (long random string)
CREATOR_API_TOKEN=
# Where questions.json is stored. On Railway mount a volume (e.g. /data) and set DATA_DIR=/data, or the queue is lost on redeploy.
DATA_DIR=./runtime
# Optional: alternate snapshot file for local testing (e.g. data/fixture.sample.json = synthetic data)
SNAPSHOT_PATH=
