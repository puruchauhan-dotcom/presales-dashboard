# Port (Railway injects PORT automatically)
PORT=8787
# Google Sheet id of "Puru - Personal Presales Tracker"
SHEET_ID=15ZC45Z1BpCuNUoTIyDL_0GRWGs0jXtJY2lKOQwkiR-A
# Full service-account key JSON on ONE line (or base64 of it). Share the sheet with the SA email as Viewer.
